#!/usr/bin/env bash
# identity-guard hook: refuse pushing to github.com/<owner> any new commit that is "ours" but not <owner> <email>.
# "Ours" = name or email matches git config identity-guard.ours (case-insensitive regex, default: the owner login).
# Outside contributors and bots pass untouched.
# Override for a reviewed history rewrite: IDENTITY_GUARD_PUSH_ALLOW=1 git push ...
owner=$(git config identity-guard.owner || true); email=$(git config identity-guard.email || true)
[[ -n "$owner" && -n "$email" ]] || exit 0
ours=$(git config identity-guard.ours || echo "$owner")
case "$2" in *github.com[:/]"$owner"/*) ;; *) exit 0;; esac
[[ "${IDENTITY_GUARD_PUSH_ALLOW:-}" == 1 ]] && exit 0
want="$owner <$email>"
bad=0
while read -r lref lsha rref rsha; do
  [[ "$lsha" =~ ^0+$ ]] && continue
  if [[ "$(git cat-file -t "$lsha")" == tag ]]; then
    tg=$(git cat-file -p "$lsha" | sed -n 's/^tagger \(.*>\).*/\1/p')
    [[ -n "$tg" && "$tg" != "$want" ]] && { echo "REFUSED: tag $rref has tagger '$tg' (must be '$want')" >&2; bad=1; }
  fi
  out=$(git rev-list --format='%h|%an <%ae>|%cn <%ce>' --no-commit-header "$lsha" --not --remotes="$1" 2>/dev/null |
    awk -F'|' -v w="$want" -v r="$rref" -v o="$(echo "$ours" | tr 'A-Z' 'a-z')" '{ for (i = 2; i <= 3; i++) { id = $i
      if (id == w || id ~ /^GitHub <noreply@github\.com>$/) continue
      if (tolower(id) ~ o) print "REFUSED: " $1 " on " r " carries \047" id "\047 (must be \047" w "\047)" } }')
  [[ -n "$out" ]] && { echo "$out" >&2; bad=1; }
done
(( bad )) && echo "Rewrite those commits (git rebase -r --exec 'git commit --amend --no-edit --reset-author') before pushing." >&2
exit $bad
